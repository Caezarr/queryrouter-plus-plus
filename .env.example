# QueryRouter++ environment variables
# Copy to .env and fill in values

# MongoDB URI for scripts/evaluate_on_librechat.py (LibreChat conversation store)
MONGO_URI=

# MongoDB root password for docker-compose.4modes.yml (required by compose)
MONGO_ROOT_PASSWORD=

# API settings
QUERYROUTER_HOST=0.0.0.0
QUERYROUTER_PORT=8000

# Provider API keys (for /v1/chat/completions proxy)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
DASHSCOPE_API_KEY=

# Optional: override provider base URLs
# QUERYROUTER_OPENAI_BASE_URL=https://api.openai.com/v1
# QUERYROUTER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
